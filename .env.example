# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/logiqon_tech_db?schema=public"

# NextAuth Authentication Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="logiqon-super-secret-key-change-in-production-2026"

# Node Environment
NODE_ENV="development"

# Application Settings
NEXT_PUBLIC_APP_NAME="LogiQ-On Tech"
NEXT_PUBLIC_APP_ENV="staging"

# MyHitch Helpdesk — external support portal where MyHitch clients (this app's users)
# log in and report issues with the software MyHitch built for them. Linked from the
# dashboard header for every signed-in user. Leave blank to show a "not configured yet"
# notice instead of a broken link.
MYHITCH_HELPDESK_URL="https://myhitchhelpdesk.com.au/"

# Microsoft 365 (Microsoft Graph, app-only). Values come from the client's tenant setup:
# Entra app registration (Tenant ID, Client ID, client secret) + two shared mailboxes,
# with Exchange RBAC for Applications scoping the app to those mailboxes only.
# When set, ALL outbound email goes through MS_SENDER_MAILBOX (SMTP_* is then only a fallback),
# Customer Inquiries reads/replies in MS_SENDER_MAILBOX, and supplier invoices are read
# from MS_INVOICE_MAILBOX (IMAP_* is then unused).
MS_TENANT_ID=""
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""                 # expires (max 24 months) — renew before expiry
MS_SENDER_MAILBOX=""                # e.g. orders@logiqon.com.au  (Mail.Send + Mail.ReadWrite)
MS_INVOICE_MAILBOX=""               # e.g. accounts@logiqon.com.au (Mail.ReadWrite)
# Optional extra supplier invoice senders, comma-separated: full addresses or @domain.
# Vendor AP/PO emails and Item Master supplier emails are always allowed.
INVOICE_ALLOWED_SENDERS=""

# Claude reads supplier invoice PDFs (invoice #, PO, totals, line serial numbers,
# courier tracking number). Leave blank to fall back to the basic regex parser,
# which cannot find tracking numbers. Get one at https://console.anthropic.com.
ANTHROPIC_API_KEY=""

# Protects /api/cron/* — Vercel sends it automatically when set.
CRON_SECRET=""

# Stripe (test mode) — get from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_REPLACE_ME"
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_ME"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_REPLACE_ME"
