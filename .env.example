# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/logiqon_tech_db?schema=public"

# NextAuth Authentication Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="logiqon-super-secret-key-change-in-production-2026"

# Node Environment
NODE_ENV="development"

# Application Settings
NEXT_PUBLIC_APP_NAME="LogiQ-On Tech"
NEXT_PUBLIC_APP_ENV="staging"

# MyHitch Helpdesk — external support portal where MyHitch clients (this app's users)
# log in and report issues with the software MyHitch built for them. Linked from the
# dashboard header for every signed-in user. Leave blank to show a "not configured yet"
# notice instead of a broken link.
MYHITCH_HELPDESK_URL="https://myhitchhelpdesk.com.au/"

# Stripe (test mode) — get from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_REPLACE_ME"
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_ME"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_REPLACE_ME"
