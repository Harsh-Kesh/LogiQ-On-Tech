generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLATFORM_OWNER
  VENDOR
  WAREHOUSE
  CUSTOMER
  MDM
}

enum VendorStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  SUSPENDED
  REJECTED
}

enum ItemStatus {
  DRAFT
  ACTIVE
  DISCONTINUED
}

enum OrderStatus {
  PLACED
  PICKING
  PACKED
  DISPATCHED
  DELIVERED
  CANCELLED
  RETURNED
}

enum LedgerMovementType {
  RECEIPT
  ISSUE
  ADJUSTMENT
  RETURN
  TRANSFER
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  fullName     String
  role         UserRole    @default(CUSTOMER)
  mfaEnabled   Boolean     @default(false)
  mfaSecret    String?
  isSuspended  Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  vendors      Vendor[]
  orders       Order[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Vendor {
  id              String       @id @default(uuid())
  companyName     String
  abnAcn          String       @unique
  status          VendorStatus @default(PENDING)
  rejectionReason String?
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  approvedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  docs            ComplianceDoc[]
  items           ItemMaster[]

  @@map("vendors")
}

model ComplianceDoc {
  id         String    @id @default(uuid())
  vendorId   String
  vendor     Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  docType    String
  fileUrl    String
  fileName   String
  fileSize   Int
  expiryDate DateTime?
  status     String    @default("PENDING")
  uploadedAt DateTime  @default(now())

  @@map("compliance_docs")
}

model Category {
  id       String     @id @default(uuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  items    ItemMaster[]

  @@map("categories")
}

model UnitOfMeasure {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  description String?

  items       ItemMaster[]

  @@map("unit_of_measures")
}

model ItemMaster {
  id             String      @id @default(uuid())
  sku            String      @unique
  barcode        String      @unique
  itemName       String
  description    String?
  categoryId     String
  category       Category    @relation(fields: [categoryId], references: [id])
  uomId          String
  uom            UnitOfMeasure @relation(fields: [uomId], references: [id])
  costPrice      Decimal     @db.Decimal(12, 2)
  sellingPrice   Decimal     @db.Decimal(12, 2)
  status         ItemStatus  @default(DRAFT)
  attributesJson String?     @db.Text
  vendorId       String?
  vendor         Vendor?     @relation(fields: [vendorId], references: [id])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  stockItems     WarehouseStock[]
  ledgerEntries  StockLedger[]
  orderItems     OrderItem[]

  @@map("item_masters")
}

model Warehouse {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockItems    WarehouseStock[]
  ledgerEntries StockLedger[]
  orders        Order[]

  @@map("warehouses")
}

model WarehouseStock {
  id             String     @id @default(uuid())
  warehouseId    String
  warehouse      Warehouse  @relation(fields: [warehouseId], references: [id])
  itemMasterId   String
  itemMaster     ItemMaster @relation(fields: [itemMasterId], references: [id])
  binLocation    String
  quantityOnHand Int        @default(0)
  quantityReserved Int      @default(0)
  updatedAt      DateTime   @updatedAt

  @@unique([warehouseId, itemMasterId, binLocation])
  @@map("warehouse_stock")
}

model StockLedger {
  id              String             @id @default(uuid())
  warehouseId     String
  warehouse       Warehouse          @relation(fields: [warehouseId], references: [id])
  itemMasterId    String
  itemMaster      ItemMaster         @relation(fields: [itemMasterId], references: [id])
  binLocation     String
  movementType    LedgerMovementType
  quantityDelta   Int
  referenceNumber String
  reasonCode      String?
  createdById     String
  createdAt       DateTime           @default(now())

  @@map("stock_ledger")
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  customerId      String
  customer        User        @relation(fields: [customerId], references: [id])
  warehouseId     String
  warehouse       Warehouse   @relation(fields: [warehouseId], references: [id])
  status          OrderStatus @default(PLACED)
  totalAmount     Decimal     @db.Decimal(12, 2)
  shippingAddress String
  trackingNumber  String?
  carrierName     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items           OrderItem[]

  @@map("orders")
}

model OrderItem {
  id           String     @id @default(uuid())
  orderId      String
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemMasterId String
  itemMaster   ItemMaster @relation(fields: [itemMasterId], references: [id])
  quantity     Int
  unitPrice    Decimal    @db.Decimal(12, 2)

  @@map("order_items")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  role        UserRole?
  action      String
  module      String
  targetId    String?
  ipAddress   String?
  payloadJson String?  @db.Text
  timestamp   DateTime @default(now())

  @@map("audit_logs")
}
